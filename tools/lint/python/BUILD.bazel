load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load(":index.bzl", "py_lint_test")

package(default_visibility = ["//visibility:public"])

bzl_lint_test(
    name = "python_lint_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

py_lint_test(
    name = "python_lint_py_lint_test",
    srcs = glob(["*.py"]),
)

exports_files(["ruff.toml"])

py_binary(
    name = "ruff_bin",
    srcs = ["ruff_bin.py"],
    deps = ["//third_party/pypi:ruff"],
)
