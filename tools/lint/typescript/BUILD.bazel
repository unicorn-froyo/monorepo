load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@npm//third_party/npm:prettier/package_json.bzl", prettier = "bin")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")

js_library(
    name = "config",
    srcs = ["eslint.config.mjs"],
    visibility = ["//visibility:public"],
)

prettier.prettier_binary(
    name = "prettier_bin",
)

js_library(
    name = "format_runner_lib",
    srcs = ["format-runner.mjs"],
)

js_binary(
    name = "format_runner",
    data = [":format_runner_lib"],
    entry_point = "format-runner.mjs",
)

js_test(
    name = "formatter_test",
    args = ["$(rootpath :prettier_bin)"],
    data = [
        "formatter.test.mjs",
        ":prettier_bin",
    ],
    entry_point = "formatter.test.mjs",
)

bzl_lint_test(
    name = "typescript_lint_bzl_lint_test",
    data = glob([
        "*.bazel",
        "*.bzl",
    ]),
)
