{
  "include": ["../../../src/apis/**/*.ts", "../../../tools/**/*.ts"],
  "compilerOptions": {
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "../../..",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "express": ["third_party/npm/node_modules/@types/express"],
      "supertest": ["third_party/npm/node_modules/@types/supertest"],
      "*": ["third_party/npm/node_modules/*"]
    },
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "typeRoots": ["../../../third_party/npm/node_modules/@types"]
  }
}
