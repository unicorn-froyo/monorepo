load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_lint_test")

package(default_visibility = ["//visibility:public"])

bzl_lint_test(
    name = "python_coverage_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "coverage_config",
    srcs = [":.coveragerc"],
)

py_binary(
    name = "coverage_bin",
    srcs = [":coverage_bin.py"],
    main = ":coverage_bin.py",
    deps = ["//third_party/pypi:coverage"],
)

py_test(
    name = "coverage_bin_test",
    srcs = ["coverage_bin_test.py"],
    data = [
        ":.coveragerc",
        ":coverage_bin.py",
    ],
    deps = ["//third_party/pypi:coverage"],
)

py_lint_test(
    name = "python_coverage_py_lint_test",
    srcs = glob(["*.py"]),
)
