load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_format_test", "py_lint_test", "py_typecheck_test")

package(default_visibility = ["//visibility:public"])

py_lint_test(
    name = "python_coverage_py_lint_test",
    srcs = glob(["*.py"]),
)

py_format_test(
    name = "python_coverage_py_format_test",
    srcs = glob(["*.py"]),
)

py_typecheck_test(
    name = "python_coverage_py_typecheck_test",
    srcs = glob(["*.py"]),
    deps = ["//third_party/pypi:coverage"],
)

bzl_lint_test(
    name = "python_coverage_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "coverage_config",
    srcs = [":.coveragerc"],
)

py_binary(
    name = "coverage_bin",
    srcs = [":coverage_bin.py"],
    main = ":coverage_bin.py",
    deps = ["//third_party/pypi:coverage"],
)
