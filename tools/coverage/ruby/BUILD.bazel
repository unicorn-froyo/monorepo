load("@rules_ruby//ruby:defs.bzl", "rb_binary")
load("//tools/coverage/ruby:index.bzl", "rb_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/ruby:index.bzl", "rb_format_test", "rb_lint_test", "rb_typecheck_test")

exports_files([
    "coverage_bin.rb",
    "lcov.rb",
])

rb_lint_test(
    name = "ruby_coverage_rb_lint_test",
    srcs = glob([
        "*.rb",
        "testdata/*.rb",
    ]),
)

rb_format_test(
    name = "ruby_coverage_rb_format_test",
    srcs = glob([
        "*.rb",
        "testdata/*.rb",
    ]),
)

rb_typecheck_test(
    name = "ruby_coverage_rb_typecheck_test",
    srcs = glob([
        "*.rb",
        "testdata/*.rb",
    ]),
)

rb_coverage_test(
    name = "ruby_coverage_lcov_test",
    srcs = [
        "artifacts_test.rb",
        "lcov_test.rb",
    ],
    data = [":artifacts_runner"],
    sources = ["lcov.rb"],
)

bzl_lint_test(
    name = "ruby_coverage_bzl_lint_test",
    data = glob([
        "*.bazel",
        "*.bzl",
    ]),
)

rb_binary(
    name = "artifacts_runner",
    srcs = [
        "coverage_bin.rb",
        "lcov.rb",
    ] + glob(["testdata/*.rb"]),
    main = "coverage_bin.rb",
    deps = ["@bundle"],
)
