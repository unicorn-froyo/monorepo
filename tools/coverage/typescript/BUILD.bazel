load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm//third_party/npm:c8/package_json.bzl", c8 = "bin")
load("//tools/coverage/typescript:index.bzl", "ts_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/typescript:index.bzl", "ts_format_bin", "ts_format_test", "ts_lint_test")

package(default_visibility = ["//visibility:public"])

ts_lint_test(
    name = "typescript_coverage_ts_lint_test",
    srcs = glob(["*.ts"]),
)

ts_format_test(
    name = "typescript_coverage_ts_format_test",
    srcs = glob(["*.ts"]),
)

ts_format_bin(
    name = "typescript_coverage_ts_format_bin",
    srcs = glob(["*.ts"]),
)

c8.c8_binary(
    name = "c8_bin",
)

ts_project(
    name = "coverage_runner_ts_lib",
    srcs = [
        "coverage-runner.ts",
        "coverage-runner-main.ts",
    ],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = ["//third_party/npm:node_modules/@types/node"],
)

js_binary(
    name = "coverage_runner",
    data = [":coverage_runner_ts_lib"],
    entry_point = "coverage-runner-main.js",
)

ts_project(
    name = "coverage_runner_test_ts_lib",
    srcs = ["coverage-runner.test.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        ":coverage_runner_ts_lib",
        "//third_party/npm:node_modules/@types/node",
    ],
)

ts_coverage_test(
    name = "coverage_runner_coverage_test",
    srcs = [
        "coverage-runner.ts",
        "coverage-runner-main.ts",
    ],
    data = [
        ":coverage_runner_test_ts_lib",
        ":coverage_runner_ts_lib",
        "//third_party/npm:node_modules",
    ],
    entry_point = "tools/coverage/typescript/coverage-runner.test.js",
)

bzl_lint_test(
    name = "typescript_coverage_bzl_lint_test",
    data = glob([
        "*.bazel",
        "*.bzl",
    ]),
)
