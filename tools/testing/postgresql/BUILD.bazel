load("@rules_oci//oci:defs.bzl", "oci_load")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")

package(default_visibility = ["//visibility:public"])

oci_load(
    name = "postgres_load",
    image = select({
        "@platforms//cpu:aarch64": "@postgres_linux_arm64_v8//:postgres_linux_arm64_v8",
        "@platforms//cpu:x86_64": "@postgres_linux_amd64//:postgres_linux_amd64",
    }),
    repo_tags = ["monorepo-postgresql:17-538bdb8c"],
    tags = ["manual"],
)

filegroup(
    name = "postgres_image",
    srcs = [":postgres_load"],
    output_group = "tarball",
)

bzl_lint_test(
    name = "postgresql_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

test_suite(
    name = "integration_tests",
    tests = [
        "//src/apis/examples/go:get_widgets_example_go_coverage_test",
        "//src/apis/examples/python:get_widgets_example_py_coverage_test",
        "//src/data/example/widgets/go:coverage_test",
        "//src/data/example/widgets/python:models_integration_test",
        "//src/data/go/postgresql:coverage_test",
        "//tools/testing/python:lifecycle_integration_test",
    ],
)
