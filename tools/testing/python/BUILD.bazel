load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/coverage/python:index.bzl", "py_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_format_test", "py_lint_test", "py_typecheck_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "lib",
    srcs = ["postgresql.py"],
    deps = [
        "//third_party/pypi:docker",
        "//third_party/pypi:postgresql",
        "//tools/migrations/python:lib",
    ],
)

py_coverage_test(
    name = "unit_test",
    srcs = [
        "postgresql_test.py",
        "//tools/migrations/python:schema_test.py",
    ],
    data = ["//tools/migrations/flyway:sqlfluff.cfg"],
    source_targets = [":lib"],
    deps = [":lib"],
)

py_lint_test(
    name = "py_lint_test",
    srcs = glob(["*.py"]),
)

py_format_test(
    name = "py_format_test",
    srcs = glob(["*.py"]),
)

py_typecheck_test(
    name = "py_typecheck_test",
    srcs = glob(["*.py"]),
    deps = [":lib"],
)

bzl_lint_test(
    name = "bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

py_binary(
    name = "postgresql_runner",
    srcs = ["postgresql.py"],
    main = "postgresql.py",
    deps = [
        "//third_party/pypi:docker",
        "//third_party/pypi:postgresql",
        "//tools/migrations/python:lib",
    ],
)

py_coverage_test(
    name = "lifecycle_integration_test",
    size = "large",
    timeout = "long",
    srcs = [
        "postgresql_integration_test.py",
        "postgresql_test.py",
        "//tools/migrations/python:schema_test.py",
    ],
    data = [
        "//src/data/example/widgets:postgres",
        "//tools/migrations/flyway:sqlfluff.cfg",
    ],
    source_targets = [":lib"],
    tags = [
        "external",
        "local",
        "no-remote",
        "no-sandbox",
        "requires-docker",
    ],
    deps = [":lib"],
)
