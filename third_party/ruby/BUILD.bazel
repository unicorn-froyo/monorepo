load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/lint/ruby:rbi.bzl", "rb_gem_rbis")

package(default_visibility = ["//visibility:public"])

pkg_tar(
    name = "gemfile_layer",
    srcs = [
        "Gemfile",
        "Gemfile.lock",
    ],
    package_dir = "/app/third_party/ruby",
    strip_prefix = ".",
)

exports_files([
    "Gemfile",
    "Gemfile.lock",
])

rb_gem_rbis(
    name = "rbi",
    srcs = [
        "Gemfile",
        "Gemfile.lock",
    ],
)
