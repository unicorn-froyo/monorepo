module(name = "com_unicorn_froyo")

postgresql = use_extension("//tools/testing/postgresql:repositories.bzl", "postgresql")
use_repo(postgresql, "postgresql_darwin_amd64", "postgresql_darwin_arm64v8", "postgresql_linux_amd64", "postgresql_linux_arm64v8")

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "gazelle", version = "0.52.2", repo_name = "bazel_gazelle")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_go", version = "0.62.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "6.9")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.3.1")
bazel_dep(name = "rules_ruby", version = "1.0.0-rc2")
bazel_dep(name = "rules_rust", version = "0.74.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//third_party/npm:package.json")
use_repo(pnpm, "pnpm")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.nogo(nogo = "//tools/lint/go:go_lint_analyzer")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//third_party/golang:go.mod")
use_repo(go_deps, "com_github_gin_gonic_gin", "com_github_jackc_pgx_v5", "io_gorm_driver_postgres", "io_gorm_gorm")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "rust_crates",
    cargo_lockfile = "//third_party/rust:dependencies.Cargo.lock",
    manifests = ["//third_party/rust:Cargo.toml"],
)
use_repo(crate, "rust_crates")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//third_party/npm:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "5.9.3")
use_repo(typescript, "npm_typescript")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14", "python_3_14_host")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.14",
    requirements_lock = "//third_party/pypi:requirements.txt",
    target_platforms = [
        "{os}_{arch}",
        "linux_aarch64",
        "linux_x86_64",
    ],
)
use_repo(pip, "pip")

ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")

# Keep native gem builds on the same Ruby patch release as the pinned image.
ruby.toolchain(
    name = "ruby",
    portable_ruby = True,
    version = "4.0.7",
)
ruby.bundle_fetch(
    name = "bundle",
    gemfile = "//third_party/ruby:Gemfile",
    gemfile_lock = "//third_party/ruby:Gemfile.lock",
)
use_repo(ruby, "bundle", "ruby", "ruby_toolchains")

register_toolchains("@ruby_toolchains//:all")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.artifact(
    name = "maven",
    artifact = "flyway-commandline",
    # Keep the PostgreSQL CLI; do not fetch drivers for every supported database.
    exclusions = ["*:*"],
    group = "org.flywaydb",
    version = "11.20.3",
)
maven.install(
    name = "maven",
    artifacts = [
        "com.google.googlejavaformat:google-java-format:1.28.0",
        "com.fasterxml.jackson.dataformat:jackson-dataformat-toml:2.20.1",
        "com.fasterxml.jackson.datatype:jackson-datatype-jsr310:2.20.1",
        "com.puppycrawl.tools:checkstyle:10.21.4",
        "jakarta.servlet:jakarta.servlet-api:6.1.0",
        "junit:junit:4.13.2",
        "org.jacoco:org.jacoco.cli:0.8.13",
        "org.jacoco:org.jacoco.agent:0.8.13:runtime",
        "org.flywaydb:flyway-core:11.20.3",
        "org.flywaydb:flyway-database-postgresql:11.20.3",
        "org.postgresql:postgresql:42.7.14",
        "org.junit.jupiter:junit-jupiter-api:5.12.2",
        "org.junit.jupiter:junit-jupiter-engine:5.12.2",
        "org.junit.platform:junit-platform-console:1.12.2",
        "org.springframework.boot:spring-boot-starter-test:4.1.2",
        "org.springframework.boot:spring-boot-starter-web:4.1.2",
    ],
    excluded_artifacts = ["com.google.errorprone:error_prone_type_annotations"],
    known_contributing_modules = [
        "com_unicorn_froyo",
        "protobuf",
    ],
    lock_file = "//third_party/java:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "postgres",
    digest = "sha256:538bdb8c6b278f2f09070a4d79f04a83363a795ed23ec0d92d6b70cabc398eae",
    image = "docker.io/library/postgres",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "java_base",
    digest = "sha256:f37956012e0cb88400e5b3689aeae2d2d735364c1922ae2225536163b5a99f56",
    image = "docker.io/library/eclipse-temurin",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "node_base",
    digest = "sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5",
    image = "docker.io/library/node",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "python_base",
    digest = "sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170",
    image = "docker.io/library/python",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "rust_base",
    digest = "sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7",
    image = "docker.io/library/rust",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "ruby_base",
    digest = "sha256:d907e08a8558207d221f257afe1bfc3e274a12bac035d8bbc9049b01b5364140",
    image = "docker.io/library/ruby",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "java_base",
    "java_base_linux_amd64",
    "java_base_linux_arm64_v8",
    "node_base",
    "node_base_linux_amd64",
    "node_base_linux_arm64_v8",
    "postgres",
    "postgres_linux_amd64",
    "postgres_linux_arm64_v8",
    "python_base",
    "python_base_linux_amd64",
    "python_base_linux_arm64_v8",
    "ruby_base",
    "ruby_base_linux_amd64",
    "ruby_base_linux_arm64_v8",
    "rust_base",
    "rust_base_linux_amd64",
    "rust_base_linux_arm64_v8",
)
