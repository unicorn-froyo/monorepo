module(name = "com_unicorn_froyo")

bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "gazelle", version = "0.52.2", repo_name = "bazel_gazelle")
bazel_dep(name = "protobuf", version = "35.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_go", version = "0.62.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_python", version = "2.3.1")
bazel_dep(name = "rules_ruby", version = "1.0.0-rc2")

_py_configure = """
if [[ "$OSTYPE" == "darwin"* ]]; then
    ./configure --prefix=$(pwd)/bazel_install --with-openssl=$(brew --prefix openssl)
else
    ./configure --prefix=$(pwd)/bazel_install
fi
"""

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "python_interpreter",
    build_file_content = """
exports_files(["python_bin"])

filegroup(
    name = "files",
    srcs = glob(["bazel_install/**"], exclude = ["**/* *"]),
    visibility = ["//visibility:public"],
)
""",
    patch_cmds = [
        "mkdir $(pwd)/bazel_install",
        _py_configure,
        "make",
        "make install",
        "ln -s bazel_install/bin/python3 python_bin",
    ],
    sha256 = "3b48dac8fb59f62eaa67ac83c1eb12bda1b7a08406dd286e252c11a66be27f81",
    strip_prefix = "Python-3.14.7",
    urls = ["https://www.python.org/ftp/python/3.14.7/Python-3.14.7.tar.xz"],
)

register_toolchains("//toolchains/python:py_toolchain")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14", "python_3_14_host")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.14",
    requirements_lock = "//third_party/pypi:requirements.txt",
)
use_repo(pip, "pip")

ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")
ruby.bundle_fetch(
    name = "bundle",
    gemfile = "//third_party/ruby:Gemfile",
    gemfile_lock = "//third_party/ruby:Gemfile.lock",
)
use_repo(ruby, "bundle")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "python_base",
    digest = "sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170",
    image = "docker.io/library/python",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "ruby_base",
    digest = "sha256:c12225b6a73743f943530d9e610f4ae78e0dbcffdcf797b01522a55f7d25acb3",
    image = "docker.io/library/ruby",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(
    oci,
    "python_base",
    "python_base_linux_amd64",
    "python_base_linux_arm64_v8",
    "ruby_base",
    "ruby_base_linux_amd64",
    "ruby_base_linux_arm64_v8",
)

buildx = use_extension("//tools/container:buildx.bzl", "buildx")
buildx.toolchains()
use_repo(buildx, "buildx")
