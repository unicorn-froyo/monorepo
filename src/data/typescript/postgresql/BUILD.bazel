load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//tools/coverage/typescript:index.bzl", "ts_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/typescript:index.bzl", "ts_format_bin", "ts_format_test", "ts_lint_test")

ts_lint_test(
    name = "lint_test",
    srcs = glob(["*.ts"]),
)

ts_format_test(
    name = "format_test",
    srcs = glob(["*.ts"]),
)

ts_format_bin(
    name = "format",
    srcs = glob(["*.ts"]),
)

bzl_lint_test(
    name = "bzl_lint_test",
    data = ["BUILD.bazel"],
)

ts_project(
    name = "lib",
    srcs = ["config.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/npm:node_modules/@types/node",
        "//third_party/npm:node_modules/reflect-metadata",
        "//third_party/npm:node_modules/typeorm",
    ],
)

ts_project(
    name = "test_lib",
    srcs = ["database.test.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        ":lib",
        "//third_party/npm:node_modules/@types/node",
        "//third_party/npm:node_modules/reflect-metadata",
        "//third_party/npm:node_modules/typeorm",
    ],
)

ts_coverage_test(
    name = "coverage_test",
    size = "large",
    timeout = "long",
    srcs = ["config.ts"],
    data = [
        ":lib",
        ":test_lib",
    ],
    entry_point = "src/data/typescript/postgresql/database.test.js",
    postgres = "//src/data/example/widgets:postgres",
)
