load("@rules_python//python:defs.bzl", "py_library")
load("//tools/coverage/python:index.bzl", "py_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_format_test", "py_lint_test", "py_typecheck_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "lib",
    srcs = ["models.py"],
    deps = ["//third_party/pypi:postgresql"],
)

py_coverage_test(
    name = "models_integration_test",
    size = "large",
    timeout = "long",
    srcs = ["models_test.py"],
    postgres = "//src/data/example/widgets:postgres",
    source_targets = [":lib"],
    deps = [
        ":lib",
        "//src/data/python/postgresql:lib",
    ],
)

py_lint_test(
    name = "py_lint_test",
    srcs = glob(["*.py"]),
)

py_format_test(
    name = "py_format_test",
    srcs = glob(["*.py"]),
)

py_typecheck_test(
    name = "py_typecheck_test",
    srcs = glob(["*.py"]),
    deps = [
        ":lib",
        "//src/data/python/postgresql:lib",
    ],
)

bzl_lint_test(
    name = "bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)
