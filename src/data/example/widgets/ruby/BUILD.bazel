load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_ruby//ruby:defs.bzl", "rb_library")
load("//tools/coverage/ruby:index.bzl", "rb_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/ruby:index.bzl", "rb_format_bin", "rb_format_test", "rb_lint_test", "rb_typecheck_test")

package(default_visibility = ["//visibility:public"])

rb_library(
    name = "lib",
    srcs = ["models.rb"],
    deps = [
        "//src/data/ruby/postgresql:lib",
        "@bundle",
    ],
)

rb_format_test(
    name = "rb_format_test",
    srcs = glob(["*.rb"]),
)

rb_format_bin(
    name = "rb_format_bin",
    srcs = glob(["*.rb"]),
)

rb_lint_test(
    name = "rb_lint_test",
    srcs = glob(["*.rb"]),
)

rb_typecheck_test(
    name = "rb_typecheck_test",
    srcs = glob(["*.rb"]) + ["//src/data/ruby/postgresql:config.rb"],
    rbis = ["//src/data/example/widgets/ruby:rbi"],
)

rb_coverage_test(
    name = "coverage_test",
    srcs = ["models_test.rb"],
    postgres = "//src/data/example/widgets:postgres",
    sources = ["models.rb"],
    deps = [":lib"],
)

pkg_tar(
    name = "layer",
    srcs = ["models.rb"],
    package_dir = "/app/src/data/example/widgets/ruby",
    strip_prefix = ".",
)

bzl_lint_test(
    name = "bzl_lint_test",
    data = ["BUILD.bazel"],
)

filegroup(
    name = "rbi",
    srcs = glob(
        ["rbi/**/*.rbi"],
        allow_empty = True,
    ),
)
