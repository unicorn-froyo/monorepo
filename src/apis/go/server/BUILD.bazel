load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/coverage/go:index.bzl", "go_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/go:index.bzl", "go_format_bin", "go_format_test", "go_lint_test")

go_library(
    name = "lib",
    srcs = ["server.go"],
    importpath = "github.com/unicorn-froyo/monorepo/src/apis/go/server",
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":lib"],
)

go_coverage_test(
    name = "coverage_test",
    target = ":server_test",
)

go_lint_test(
    name = "go_lint_test",
    targets = [":lib"],
)

go_format_test(
    name = "go_format_test",
    srcs = glob(["*.go"]),
)

go_format_bin(
    name = "go_format_bin",
    srcs = glob(["*.go"]),
)

bzl_lint_test(
    name = "bzl_lint_test",
    data = ["BUILD.bazel"],
)
