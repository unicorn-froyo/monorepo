load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_ruby//ruby:defs.bzl", "rb_library", "rb_test")
load("//tools/coverage/ruby:index.bzl", "rb_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/ruby:index.bzl", "rb_lint_test")

package(default_visibility = ["//src/apis:__subpackages__"])

rb_lint_test(
    name = "api_base_rb_lint_test",
    srcs = glob(["*.rb"]),
)

rb_coverage_test(
    name = "api_base_rb_coverage_test",
    srcs = [":abstract_api_base_test.rb"],
    deps = [":api_base_rb_lib"],
)

rb_coverage_test(
    name = "api_base_rb_multi_coverage_test",
    srcs = [
        ":abstract_api_base_test.rb",
        ":coverage_data_test.rb",
    ],
    data = ["coverage_fixture.txt"],
    deps = [":api_base_rb_lib"],
)

bzl_lint_test(
    name = "api_base_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

pkg_tar(
    name = "api_base_layer",
    srcs = [
        "abstract_api_base.rb",
        "security_headers.rb",
    ],
    package_dir = "/app/src/apis/ruby",
    strip_prefix = ".",
)

rb_library(
    name = "api_base_rb_lib",
    srcs = [
        ":abstract_api_base.rb",
        ":security_headers.rb",
    ],
    deps = ["@bundle"],
)

rb_test(
    name = "api_base_rb_test",
    srcs = [":abstract_api_base_test.rb"],
    args = ["src/apis/ruby/abstract_api_base_test.rb"],
    deps = [
        ":api_base_rb_lib",
        "@bundle",
    ],
)
