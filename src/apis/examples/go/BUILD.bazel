load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools:platform_transition.bzl", "platform_target")
load("//tools/coverage/go:index.bzl", "go_coverage_test")
load("//tools/deploy/api:index.bzl", "deploy_api")
load("//tools/image:index.bzl", "image_with_load")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/go:index.bzl", "go_format_bin", "go_format_test", "go_lint_test")

go_lint_test(
    name = "get_widgets_example_go_lint_test",
    targets = [":get_widgets_example_go_lib"],
)

go_format_test(
    name = "get_widgets_example_go_format_test",
    srcs = glob(["*.go"]),
)

go_format_bin(
    name = "get_widgets_example_go_format_bin",
    srcs = glob(["*.go"]),
)

go_coverage_test(
    name = "get_widgets_example_go_coverage_test",
    target = ":get_widgets_example_go_test",
)

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

go_library(
    name = "get_widgets_example_go_lib",
    srcs = [
        "get_widgets.go",
        "server.go",
    ],
    importpath = "github.com/unicorn-froyo/monorepo/src/apis/examples/go",
    visibility = ["//visibility:private"],
    deps = [
        "//src/apis/go:api_base_go_lib",
        "@com_github_gin_gonic_gin//:gin",
    ],
)

go_binary(
    name = "server",
    embed = [":get_widgets_example_go_lib"],
)

go_test(
    name = "get_widgets_example_go_test",
    srcs = ["get_widgets_test.go"],
    embed = [":get_widgets_example_go_lib"],
    deps = ["@com_github_gin_gonic_gin//:gin"],
)

platform_target(
    name = "linux_server",
    platform = select({
        "@platforms//cpu:arm64": "//tools/toolchains:aarch64_linux",
        "@platforms//cpu:x86_64": "//tools/toolchains:x86_64_linux",
    }),
    target = ":server",
)

pkg_tar(
    name = "application_layer",
    srcs = [":linux_server"],
    mode = "0555",
    package_dir = "/app",
)

image_with_load(
    name = "get_widgets_example_oci",
    architecture = select({
        "@platforms//cpu:arm64": "arm64",
        "@platforms//cpu:x86_64": "amd64",
    }),
    entrypoint = ["/app/server"],
    env = {"GIN_MODE": "release"},
    load_name = "get_widgets_example_image",
    os = "linux",
    repo_tags = ["get-widgets-go:latest"],
    tags = ["manual"],
    tars = [":application_layer"],
)

deploy_api(
    name = "get-widgets-qa",
    deployment_zone = "//src/zones/examples:example_qa",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-go:latest",
    tags = [
        "manual",
        "qa",
    ],
)

deploy_api(
    name = "get-widgets-prod",
    deployment_zone = "//src/zones/examples:example_prod",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-go:latest",
    tags = [
        "manual",
        "prod",
    ],
)
