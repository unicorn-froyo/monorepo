load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/coverage/rust:index.bzl", "rs_coverage_test")
load("//tools/deploy/api:index.bzl", "deploy_api")
load("//tools/image/rust:index.bzl", "rs_image")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/rust:index.bzl", "rs_format_bin", "rs_format_test", "rs_lint_test")
load("//tools/package/rust:index.bzl", "rs_package")

rs_coverage_test(
    name = "get_widgets_example_rs_coverage_test",
    target = ":get_widgets_example_rs_test",
)

rs_lint_test(
    name = "get_widgets_example_rs_lint_test",
    targets = [
        ":get_widgets_example_rs_lib",
        ":get_widgets_example_rs_test",
        ":server",
    ],
)

rs_format_test(
    name = "get_widgets_example_rs_format_test",
    targets = [
        ":get_widgets_example_rs_lib",
        ":get_widgets_example_rs_test",
        ":server",
    ],
)

rs_format_bin(
    name = "get_widgets_example_rs_format_bin",
    srcs = glob(["*.rs"]),
)

exports_files(["Cargo.toml"])

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "get_widgets_example_rs_lib",
    srcs = ["get_widgets.rs"],
    crate_name = "get_widgets",
    edition = "2021",
    deps = [
        "//src/apis/rust:api_base_rs_lib",
        "@rust_crates//:axum",
    ],
)

rust_binary(
    name = "server",
    srcs = ["server.rs"],
    edition = "2021",
    deps = [
        ":get_widgets_example_rs_lib",
        "@rust_crates//:axum",
        "@rust_crates//:tokio",
    ],
)

rust_test(
    name = "get_widgets_example_rs_test",
    srcs = ["get_widgets_test.rs"],
    edition = "2021",
    deps = [
        ":get_widgets_example_rs_lib",
        "@rust_crates//:axum",
        "@rust_crates//:tokio",
        "@rust_crates//:tower",
    ],
)

rs_package(
    name = "application_layer",
    binary = ":server",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

rs_image(
    name = "get_widgets_example_oci",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    tars = [":application_layer"],
)

oci_load(
    name = "get_widgets_example_image",
    image = ":get_widgets_example_oci",
    repo_tags = ["get-widgets-rust:latest"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "get_widgets_example_image_smoke_test",
    srcs = ["image_smoke_test.sh"],
    tags = [
        "local",
        "manual",
        "requires-docker",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

deploy_api(
    name = "get-widgets-qa",
    deployment_zone = "//src/zones/examples:example_qa",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-rust:latest",
    tags = [
        "manual",
        "qa",
    ],
)

deploy_api(
    name = "get-widgets-prod",
    deployment_zone = "//src/zones/examples:example_prod",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-rust:latest",
    tags = [
        "manual",
        "prod",
    ],
)
