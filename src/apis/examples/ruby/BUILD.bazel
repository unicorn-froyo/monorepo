load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_ruby//ruby:defs.bzl", "rb_library", "rb_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

rb_library(
    name = "get_widgets_example_rb_lib",
    srcs = [":get_widgets.rb"],
    deps = [
        "//src/apis/ruby:api_base_rb_lib",
        "@bundle",
    ],
)

rb_test(
    name = "get_widgets_example_rb_test",
    srcs = [":get_widgets_test.rb"],
    args = ["src/apis/examples/ruby/get_widgets_test.rb"],
    deps = [
        ":get_widgets_example_rb_lib",
        "@bundle",
    ],
)

pkg_tar(
    name = "application_layer",
    srcs = [
        "config.ru",
        "get_widgets.rb",
        "server.sh",
    ],
    package_dir = "/app/src/apis/examples/ruby",
    strip_prefix = ".",
)

pkg_tar(
    name = "gems_layer",
    srcs = ["@bundle"],
    package_dir = "/usr/local/bundle",
    strip_prefix = "vendor/bundle",
)

pkg_tar(
    name = "linux_gem_layer",
    srcs = select({
        "@platforms//cpu:arm64": ["@bundle//:third_party/ruby/vendor/cache/nokogiri-1.19.4-aarch64-linux-gnu.gem"],
        "@platforms//cpu:x86_64": ["@bundle//:third_party/ruby/vendor/cache/nokogiri-1.19.4-x86_64-linux-gnu.gem"],
    }),
    package_dir = "/usr/local/bundle/external/rules_ruby++ruby+bundle/vendor/bundle/ruby/4.0.0/cache",
    remap_paths = {
        "external/rules_ruby++ruby+bundle/third_party/ruby/vendor/cache": ".",
    },
)

oci_image(
    name = "get_widgets_example_oci",
    base = select({
        "@platforms//cpu:arm64": "@ruby_base_linux_arm64_v8",
        "@platforms//cpu:x86_64": "@ruby_base_linux_amd64",
    }),
    entrypoint = [
        "/bin/sh",
        "/app/src/apis/examples/ruby/server.sh",
    ],
    env = {
        "BUNDLE_CACHE_PATH": "/usr/local/bundle/external/rules_ruby++ruby+bundle/vendor/bundle/ruby/4.0.0/cache",
        "BUNDLE_FROZEN": "true",
        "BUNDLE_GEMFILE": "/app/third_party/ruby/Gemfile",
        "BUNDLE_PATH": "/tmp/bundle",
        "RAILS_ENV": "production",
    },
    tags = ["manual"],
    tars = [
        ":gems_layer",
        ":linux_gem_layer",
        "//third_party/ruby:gemfile_layer",
        "//src/apis/ruby:api_base_layer",
        ":application_layer",
    ],
    workdir = "/app",
)

oci_load(
    name = "get_widgets_example_image",
    image = ":get_widgets_example_oci",
    repo_tags = ["get-widgets-ruby:latest"],
    tags = ["manual"],
)
