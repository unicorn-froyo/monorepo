load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "REMOVE_BASE_DIRECTORY", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_ruby//ruby:defs.bzl", "rb_library", "rb_test")
load("//tools/coverage/ruby:index.bzl", "rb_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/ruby:index.bzl", "rb_lint_test")

rb_coverage_test(
    name = "get_widgets_example_rb_coverage_test",
    srcs = [":get_widgets_test.rb"],
    deps = [":get_widgets_example_rb_lib"],
)

rb_lint_test(
    name = "get_widgets_example_rb_lint_test",
    srcs = glob([
        "*.rb",
        "*.ru",
    ]),
)

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

rb_library(
    name = "get_widgets_example_rb_lib",
    srcs = [":get_widgets.rb"],
    deps = [
        "//src/apis/ruby:api_base_rb_lib",
        "@bundle",
    ],
)

rb_test(
    name = "get_widgets_example_rb_test",
    srcs = [":get_widgets_test.rb"],
    args = ["src/apis/examples/ruby/get_widgets_test.rb"],
    deps = [
        ":get_widgets_example_rb_lib",
        "@bundle",
    ],
)

pkg_tar(
    name = "application_layer",
    srcs = [
        "config.ru",
        "get_widgets.rb",
        "server.sh",
    ],
    package_dir = "/app/src/apis/examples/ruby",
    strip_prefix = ".",
)

# A native Linux worker installs the bundle, including source-gem extensions,
# before packaging. Incompatible image targets give an explicit Linux platform
# diagnostic when requested from macOS; ordinary build //... remains portable.
filegroup(
    name = "installed_gems",
    srcs = ["@bundle"],
    output_group = "gems",
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_files(
    name = "bundle_files",
    srcs = [":installed_gems"],
    prefix = "/usr/local/bundle",
    renames = {
        ":installed_gems": REMOVE_BASE_DIRECTORY,
    },
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_tar(
    name = "gems_layer",
    srcs = [
        ":bundle_files",
        ":bundler_files",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# bundle install does not install Bundler itself into its output tree. Include
# the locked version so RubyGems never attempts to download it at startup.
pkg_files(
    name = "bundler_files",
    srcs = ["@bundle//:bundler-2.6.9"],
    excludes = ["@bundle//:third_party/ruby/vendor/cache/bundler-2.6.9.gem"],
    prefix = "/usr/local/bundle/ruby/4.0.0",
    strip_prefix = strip_prefix.from_root("bundler-2.6.9"),
    target_compatible_with = ["@platforms//os:linux"],
)

oci_image(
    name = "get_widgets_example_oci",
    base = select({
        "@platforms//cpu:arm64": "@ruby_base_linux_arm64_v8",
        "@platforms//cpu:x86_64": "@ruby_base_linux_amd64",
    }),
    entrypoint = [
        "/bin/sh",
        "/app/src/apis/examples/ruby/server.sh",
    ],
    env = {
        "BUNDLE_DISABLE_SHARED_GEMS": "true",
        "BUNDLE_FROZEN": "true",
        "BUNDLE_GEMFILE": "/app/third_party/ruby/Gemfile",
        "BUNDLE_IGNORE_CONFIG": "true",
        "BUNDLE_PATH": "/usr/local/bundle",
        "GEM_HOME": "/usr/local/bundle/ruby/4.0.0",
        "GEM_PATH": "/usr/local/bundle/ruby/4.0.0",
        "RAILS_ENV": "production",
    },
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    tars = [
        ":gems_layer",
        "//third_party/ruby:gemfile_layer",
        "//src/apis/ruby:api_base_layer",
        ":application_layer",
    ],
    workdir = "/app",
)

oci_load(
    name = "get_widgets_example_image",
    image = ":get_widgets_example_oci",
    repo_tags = ["get-widgets-ruby:latest"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
