load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools:platform_transition.bzl", "platform_target")
load("//tools/coverage/python:index.bzl", "py_coverage_test")
load("//tools/deploy/api:index.bzl", "deploy_api")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_format_test", "py_lint_test", "py_typecheck_test")

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

py_binary(
    name = "get_widgets_example_py_lib",
    srcs = [":get_widgets.py"],
    main = ":get_widgets.py",
    deps = [
        "//src/apis/python:api_base_py_lib",
        "//third_party/pypi:fastapi",
    ],
)

py_coverage_test(
    name = "get_widgets_example_py_coverage_test",
    srcs = [
        ":get_widgets_test.py",
        "//src/apis/python:abstract_api_base_test.py",
    ],
    source_targets = [":get_widgets_example_py_lib"],
    deps = [
        ":get_widgets_example_py_lib",
        "//third_party/pypi:fastapi",
    ],
)

py_lint_test(
    name = "get_widgets_example_py_lint_test",
    srcs = glob(["*.py"]),
)

py_format_test(
    name = "get_widgets_example_py_format_test",
    srcs = glob(["*.py"]),
)

py_typecheck_test(
    name = "get_widgets_example_py_typecheck_test",
    srcs = glob(["*.py"]),
    deps = [":server"],
)

py_binary(
    name = "server",
    srcs = ["server.py"],
    deps = [
        ":get_widgets_example_py_lib",
        "//third_party/pypi:uvicorn",
    ],
)

platform(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform_target(
    name = "linux_server",
    platform = select({
        "@platforms//cpu:arm64": ":aarch64_linux",
        "@platforms//cpu:x86_64": ":x86_64_linux",
    }),
    target = ":server",
)

pkg_tar(
    name = "application_layer",
    srcs = [":linux_server"],
    include_runfiles = True,
    package_dir = "/app",
)

oci_image(
    name = "get_widgets_example_oci",
    base = select({
        "@platforms//cpu:arm64": "@python_base_linux_arm64_v8",
        "@platforms//cpu:x86_64": "@python_base_linux_amd64",
    }),
    entrypoint = ["/app/server"],
    tags = ["manual"],
    tars = [":application_layer"],
)

oci_load(
    name = "get_widgets_example_image",
    image = ":get_widgets_example_oci",
    repo_tags = ["get-widgets-python:latest"],
    tags = ["manual"],
)

deploy_api(
    name = "get-widgets-qa",
    deployment_zone = "//src/zones/examples:example_qa",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-python:latest",
    tags = [
        "manual",
        "qa",
    ],
)

deploy_api(
    name = "get-widgets-prod",
    deployment_zone = "//src/zones/examples:example_prod",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-python:latest",
    tags = [
        "manual",
        "prod",
    ],
)
