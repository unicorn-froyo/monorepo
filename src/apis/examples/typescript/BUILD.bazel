load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_info_files")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//tools/coverage/typescript:index.bzl", "ts_coverage_test")
load("//tools/deploy/api:index.bzl", "deploy_api")
load("//tools/image/typescript:index.bzl", "ts_image")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/typescript:index.bzl", "ts_format_bin", "ts_format_test", "ts_lint_test")

ts_lint_test(
    name = "get_widgets_example_ts_lint_test",
    srcs = glob(["*.ts"]),
)

ts_format_test(
    name = "get_widgets_example_ts_format_test",
    srcs = glob(["*.ts"]),
)

ts_format_bin(
    name = "get_widgets_example_ts_format_bin",
    srcs = glob(["*.ts"]),
)

bzl_lint_test(
    name = "get_widgets_example_bzl_lint_test",
    data = ["BUILD.bazel"],
)

ts_project(
    name = "get_widgets_example_ts_lib",
    srcs = ["get-widgets.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        "//src/apis/typescript:api_base_ts_lib",
        "//src/data/example/widgets/typescript:lib",
        "//third_party/npm:node_modules/@nestjs/common",
    ],
)

ts_project(
    name = "server_lib",
    srcs = [
        "index.ts",
        "server.ts",
    ],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        ":get_widgets_example_ts_lib",
        "//src/apis/typescript:api_base_ts_lib",
        "//src/data/example/widgets/typescript:lib",
        "//third_party/npm:node_modules/@nestjs/platform-express",
        "//third_party/npm:node_modules/@types/node",
    ],
)

js_binary(
    name = "server",
    data = [":server_lib"],
    entry_point = "index.js",
    env = {"NODE_PATH": "third_party/npm/node_modules"},
)

ts_project(
    name = "get_widgets_example_ts_test_lib",
    srcs = ["get-widgets.test.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        ":get_widgets_example_ts_lib",
        ":server_lib",
        "//src/apis/typescript:api_base_ts_lib",
        "//src/data/example/widgets/typescript:lib",
        "//src/data/typescript/postgresql:lib",
        "//third_party/npm:node_modules/@nestjs/platform-express",
        "//third_party/npm:node_modules/@types/node",
        "//third_party/npm:node_modules/@types/supertest",
        "//third_party/npm:node_modules/supertest",
        "//third_party/npm:node_modules/typeorm",
    ],
)

ts_coverage_test(
    name = "get_widgets_example_ts_coverage_test",
    size = "large",
    timeout = "long",
    srcs = [
        "get-widgets.ts",
        "index.ts",
        "server.ts",
        "//src/apis/typescript:api_base_ts_srcs",
    ],
    data = [
        ":get_widgets_example_ts_lib",
        ":get_widgets_example_ts_test_lib",
        ":server_lib",
    ],
    entry_point = "src/apis/examples/typescript/get-widgets.test.js",
    postgres = "//src/data/example/widgets:postgres",
)

js_info_files(
    name = "runtime_files",
    srcs = [":server_lib"],
)

pkg_tar(
    name = "application_layer",
    srcs = [":runtime_files"],
    package_dir = "/app",
    strip_prefix = "/",
)

ts_image(
    name = "get_widgets_example_oci",
    entrypoint = [
        "node",
        "/app/src/apis/examples/typescript/index.js",
    ],
    env = {
        "NODE_PATH": "/app/third_party/npm/node_modules",
    },
    load_name = "get_widgets_example_image",
    repo_tags = ["get-widgets-typescript:latest"],
    tars = [":application_layer"],
)

deploy_api(
    name = "get-widgets-qa",
    deployment_zone = "//src/zones/examples:example_qa",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-typescript:latest",
    tags = [
        "manual",
        "qa",
    ],
)

deploy_api(
    name = "get-widgets-prod",
    deployment_zone = "//src/zones/examples:example_prod",
    image = ":get_widgets_example_oci",
    image_name = "get-widgets-typescript:latest",
    tags = [
        "manual",
        "prod",
    ],
)
