load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")

bzl_lint_test(
    name = "api_base_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

pkg_tar(
    name = "api_base_layer",
    srcs = ["abstract_api_base.rs"],
    package_dir = "/app/src/apis/rust",
    strip_prefix = ".",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "api_base_rs_lib",
    srcs = ["abstract_api_base.rs"],
    crate_name = "api_base",
    edition = "2021",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "api_base_rs_test",
    srcs = ["abstract_api_base_test.rs"],
    edition = "2021",
    deps = [":api_base_rs_lib"],
)
