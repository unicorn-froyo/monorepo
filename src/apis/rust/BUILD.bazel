load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/coverage/rust:index.bzl", "rs_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/rust:index.bzl", "rs_lint_test")

rs_coverage_test(
    name = "api_base_rs_coverage_test",
    target = ":api_base_rs_test",
)

rs_lint_test(
    name = "api_base_rs_lint_test",
    targets = [
        ":api_base_rs_lib",
        ":api_base_rs_test",
    ],
)

exports_files(["Cargo.toml"])

bzl_lint_test(
    name = "api_base_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

rust_library(
    name = "api_base_rs_lib",
    srcs = ["abstract_api_base.rs"],
    crate_name = "api_base",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["@rust_crates//:axum"],
)

rust_test(
    name = "api_base_rs_test",
    srcs = ["abstract_api_base_test.rs"],
    edition = "2021",
    deps = [
        ":api_base_rs_lib",
        "@rust_crates//:axum",
        "@rust_crates//:tokio",
        "@rust_crates//:tower",
    ],
)
