load("@rules_python//python:defs.bzl", "py_library")
load("//tools/coverage/python:index.bzl", "py_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/python:index.bzl", "py_format_test", "py_lint_test", "py_typecheck_test")

package(default_visibility = ["//src/apis:__subpackages__"])

bzl_lint_test(
    name = "api_base_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

py_library(
    name = "api_base_py_lib",
    srcs = [
        ":abstract_api_base.py",
        ":security_headers.py",
    ],
    deps = ["//third_party/pypi:fastapi"],
)

py_coverage_test(
    name = "api_base_py_coverage_test",
    srcs = [":abstract_api_base_test.py"],
    source_targets = [":api_base_py_lib"],
    deps = [
        ":api_base_py_lib",
        "//third_party/pypi:fastapi",
    ],
)

py_lint_test(
    name = "api_base_py_lint_test",
    srcs = glob(["*.py"]),
)

py_format_test(
    name = "api_base_py_format_test",
    srcs = glob(["*.py"]),
)

py_typecheck_test(
    name = "api_base_py_typecheck_test",
    srcs = glob(["*.py"]),
    deps = [":api_base_py_lib"],
)
