        ":api_base_ts_test_lib",
        "//third_party/npm:node_modules",
        "//third_party/npm:node_modules/express",
        "//third_party/npm:node_modules/supertest",
    ],
    entry_points = [
        "src/apis/typescript/abstract-api-base.test.js",
