load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("//tools/coverage/typescript:index.bzl", "ts_coverage_test")
load("//tools/lint/bazel:index.bzl", "bzl_lint_test")
load("//tools/lint/typescript:index.bzl", "ts_format_bin", "ts_format_test", "ts_lint_test")

ts_lint_test(
    name = "api_base_ts_lint_test",
    srcs = glob(["*.ts"]),
)

ts_format_test(
    name = "api_base_ts_format_test",
    srcs = glob(["*.ts"]),
)

ts_format_bin(
    name = "api_base_ts_format_bin",
    srcs = glob(["*.ts"]),
)

filegroup(
    name = "api_base_ts_srcs",
    srcs = ["api-base.ts"],
    visibility = ["//visibility:public"],
)

ts_coverage_test(
    name = "api_base_ts_coverage_test",
    srcs = ["api-base.ts"],
    data = [
        ":api_base_ts_lib",
        ":api_base_ts_test_lib",
        "//third_party/npm:node_modules",
        "//third_party/npm:node_modules/@nestjs/common",
        "//third_party/npm:node_modules/@nestjs/core",
        "//third_party/npm:node_modules/@nestjs/platform-express",
        "//third_party/npm:node_modules/reflect-metadata",
        "//third_party/npm:node_modules/rxjs",
        "//third_party/npm:node_modules/supertest",
    ],
    entry_point = "src/apis/typescript/api-base.test.js",
)

bzl_lint_test(
    name = "api_base_bzl_lint_test",
    data = glob(
        [
            "*.bazel",
            "*.bzl",
        ],
        allow_empty = True,
    ),
)

ts_project(
    name = "api_base_ts_lib",
    srcs = ["api-base.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/npm:node_modules/@nestjs/common",
        "//third_party/npm:node_modules/@nestjs/core",
        "//third_party/npm:node_modules/@nestjs/platform-express",
        "//third_party/npm:node_modules/@types/express",
        "//third_party/npm:node_modules/@types/node",
        "//third_party/npm:node_modules/reflect-metadata",
        "//third_party/npm:node_modules/rxjs",
    ],
)

ts_project(
    name = "api_base_ts_test_lib",
    srcs = ["api-base.test.ts"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "//tools/toolchains/typescript:tsconfig",
    deps = [
        ":api_base_ts_lib",
        "//third_party/npm:node_modules/@nestjs/common",
        "//third_party/npm:node_modules/@types/node",
        "//third_party/npm:node_modules/@types/supertest",
        "//third_party/npm:node_modules/supertest",
    ],
)
